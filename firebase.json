{
  "hosting": {
    "public": "website",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "downloads/**",
      "chrome_cookies_temp/**",
      "*.py",
      "*.bat"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "grabnow"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
